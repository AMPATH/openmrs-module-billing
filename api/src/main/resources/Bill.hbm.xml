<!DOCTYPE hibernate-mapping PUBLIC
		"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
		"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.openmrs.module.billing.api.model">

	<!--
		Scopes billing data to a set of locations. A bill and everything hanging off it are reached
		through the location of the cash point the bill was created at, which is also what
		BillSearch.locationUuid filters on; a catalogue entry (BillableService, BillableDrug) is reached
		through its own location_id, where null means the entry is global and stays visible everywhere.
		The parameter is set per session by the billing module's DataFilterListener, see
		org.openmrs.module.billing.api.datafilter.BillingLocationFilterListener and the registration in
		filters/hibernate/billing_location.json. A filter that is never enabled has no effect on any
		query, so declaring it here is inert unless the datafilter module is installed and
		billing.dataFilter.enabled is true.

		The condition is declared per class rather than here, because each table reaches the location
		differently. Every column of a table referenced in a sub query is qualified with an alias, and
		only the filtered table's own column is left unqualified, so that hibernate's alias injection
		prefixes that one column and leaves the sub queries alone. A condition whose top level is OR or
		AND brackets itself, because hibernate appends each filter as " and <condition>" with no
		parentheses of its own.

		These filters govern queries, so a bill fetched by id (BillDAO.getBill) and any association
		navigated from an already loaded object are NOT scoped, which is hibernate's documented behaviour
		for filters and the same limitation datafilter has.
	-->
	<filter-def name="billing_locationBasedBillingFilter">
		<filter-param name="allowedLocationIds" type="integer"/>
	</filter-def>

	<class name="org.openmrs.module.billing.api.model.CashierItemPrice" table="cashier_item_price">
		<cache usage="read-write"/>
		<id name="id" type="int" column="item_price_id">
			<generator class="native">
				<param name="sequence">inv_item_price_item_price_id_seq</param>
			</generator>
		</id>
		<discriminator column="item_price_id" insert="false"/>

		<many-to-one name="item" class="org.openmrs.module.stockmanagement.api.model.StockItem" not-null="false"
		             column="item_id"/>
		<many-to-one name="billableService" class="org.openmrs.module.billing.api.model.BillableService"
		             not-null="false" column="service_id"/>
		<many-to-one name="billableDrug" class="org.openmrs.module.billing.api.model.BillableDrug"
		             not-null="false" column="billable_drug_id"/>
		<many-to-one name="paymentMode" class="org.openmrs.module.billing.api.model.PaymentMode" not-null="false"
		             column="payment_mode"/>

		<property name="name" type="java.lang.String" column="name" not-null="false" length="255"/>
		<property name="price" type="java.math.BigDecimal" column="price" not-null="true"/>

		<many-to-one name="creator" class="org.openmrs.User" not-null="true" column="creator"/>
		<property name="dateCreated" type="java.util.Date" column="date_created" not-null="true" length="19"/>

		<many-to-one name="changedBy" class="org.openmrs.User" column="changed_by"/>
		<property name="dateChanged" type="java.util.Date" column="date_changed" length="19"/>

		<property name="retired" type="java.lang.Boolean" column="retired" length="1" not-null="true"/>
		<many-to-one name="retiredBy" class="org.openmrs.User" column="retired_by"/>
		<property name="dateRetired" type="java.util.Date" column="date_retired" length="19"/>
		<property name="retireReason" type="java.lang.String" column="retire_reason" length="255"/>

		<property name="uuid" type="java.lang.String" column="uuid" length="38" unique="true"/>
		<!-- Prices belong to a catalogue entry and follow it, see the filter-def above. A price of a
		     stock item belongs to no catalogue entry and is left alone. -->
		<filter name="billing_locationBasedBillingFilter"
		        condition="((service_id IS NULL OR service_id IN (SELECT billing_bs.service_id
		                   FROM cashier_billable_service billing_bs
		                   WHERE billing_bs.location_id IN (:allowedLocationIds) OR billing_bs.location_id IS NULL))
		                   AND (billable_drug_id IS NULL OR billable_drug_id IN (SELECT billing_bd.billable_drug_id
		                   FROM cashier_billable_drug billing_bd
		                   WHERE billing_bd.location_id IN (:allowedLocationIds) OR billing_bd.location_id IS NULL)))"/>
	</class>

	<class name="org.openmrs.module.billing.api.model.BillableService" table="cashier_billable_service">
		<cache usage="read-write"/>

		<id name="id" type="int" column="service_id">
			<generator class="native">
				<param name="sequence">cashier_billable_service_id_seq</param>
			</generator>
		</id>
		<discriminator column="service_id" insert="false"/>


		<property name="name" type="java.lang.String" column="name" not-null="true" length="255"/>
		<property name="shortName" type="java.lang.String" column="short_name" length="255"/>
		<many-to-one name="concept" class="org.openmrs.Concept" not-null="false" column="concept_id"/>

		<many-to-one name="serviceType" class="org.openmrs.Concept" not-null="false" column="service_type"/>
		<many-to-one name="serviceCategory" class="org.openmrs.Concept" not-null="false" column="service_category"/>
		<many-to-one name="location" class="org.openmrs.Location" not-null="false" column="location_id"/>

		<bag name="servicePrices" lazy="false" inverse="true" cascade="all-delete-orphan">
			<key column="service_id"/>
			<one-to-many class="org.openmrs.module.billing.api.model.CashierItemPrice"/>
		</bag>

		<property name="serviceStatus" column="service_status" not-null="true">
			<type name="org.hibernate.type.EnumType">
				<param name="enumClass">org.openmrs.module.billing.api.model.BillableServiceStatus</param>
				<param name="type">12</param>
			</type>
		</property>
		<!-- bi-directional many-to-one association to User -->
		<many-to-one name="creator" class="org.openmrs.User" not-null="true" column="creator"/>
		<property name="dateCreated" type="java.util.Date" column="date_created" not-null="true" length="19"/>

		<many-to-one name="changedBy" class="org.openmrs.User" column="changed_by"/>
		<property name="dateChanged" type="java.util.Date" column="date_changed" length="19"/>

		<property name="retired" type="java.lang.Boolean" column="retired" length="1" not-null="true"/>
		<many-to-one name="retiredBy" class="org.openmrs.User" column="retired_by"/>
		<property name="dateRetired" type="java.util.Date" column="date_retired" length="19"/>
		<property name="retireReason" type="java.lang.String" column="retire_reason" length="255"/>

		<property name="uuid" type="java.lang.String" column="uuid" length="38" unique="true"/>
		<!-- A catalogue entry with no location is global, see the filter-def above -->
		<filter name="billing_locationBasedBillingFilter"
		        condition="(location_id IN (:allowedLocationIds) OR location_id IS NULL)"/>
	</class>

	<class name="org.openmrs.module.billing.api.model.BillableDrug" table="cashier_billable_drug">
