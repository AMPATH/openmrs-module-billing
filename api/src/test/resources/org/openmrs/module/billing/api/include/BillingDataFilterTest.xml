	                      amount_tendered="20.00" creator="1" date_created="2012-01-01 00:00:00.0"
	                      voided="false" uuid="a6000000-0000-0000-0000-000000000200"/>

	<bill_discount bill_discount_id="100" bill_id="100" discount_type="PERCENTAGE" discount_value="10.00"
	               discount_status="APPROVED" justification="Scoped clinic waiver" initiator_id="1" creator="1"
	               date_created="2012-01-02 00:00:00.0" voided="false"
	               uuid="a7000000-0000-0000-0000-000000000100"/>
	<bill_discount bill_discount_id="200" bill_id="200" discount_type="PERCENTAGE" discount_value="20.00"
	               discount_status="APPROVED" justification="Other hospital waiver" initiator_id="1" creator="1"
	               date_created="2012-01-02 00:00:00.0" voided="false"
	               uuid="a7000000-0000-0000-0000-000000000200"/>

	<bill_refund bill_refund_id="100" bill_id="100" refund_amount="10.00" reason="Scoped clinic refund"
	             refund_status="REQUESTED" initiator_id="1" creator="1" date_created="2012-01-02 00:00:00.0"
	             voided="false" uuid="a8000000-0000-0000-0000-000000000100"/>
