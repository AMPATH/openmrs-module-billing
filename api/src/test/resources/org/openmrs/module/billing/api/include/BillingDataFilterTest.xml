	                    date_created="2012-01-01 00:00:00.0" retired="false"
	                    uuid="b3000000-0000-0000-0000-000000000700"/>

	<!-- Bill at the allowed clinic, adjusted by one bill from each location tree -->
	<cashier_bill bill_id="100" receipt_number="scoped-clinic-receipt" provider_id="0" patient_id="0"
	              cash_point_id="100" status="POSTED" creator="1" date_created="2012-01-01 00:00:00.0"
	              voided="false" receipt_printed="0" uuid="a4000000-0000-0000-0000-000000000100"/>
	<cashier_bill bill_id="101" receipt_number="scoped-clinic-adjustment" provider_id="0" patient_id="0"
	              cash_point_id="100" status="POSTED" adjusted_bill_id="100" creator="1"
	              date_created="2012-01-02 00:00:00.0" voided="false" receipt_printed="0"
	              uuid="a4000000-0000-0000-0000-000000000101"/>
	<cashier_bill bill_id="200" receipt_number="other-hospital-receipt" provider_id="0" patient_id="0"
	              cash_point_id="200" status="POSTED" creator="1" date_created="2012-01-01 00:00:00.0"
	              voided="false" receipt_printed="0" uuid="a4000000-0000-0000-0000-000000000200"/>
	<cashier_bill bill_id="201" receipt_number="other-hospital-adjustment" provider_id="0" patient_id="0"
	              cash_point_id="200" status="POSTED" adjusted_bill_id="100" creator="1"
	              date_created="2012-01-02 00:00:00.0" voided="false" receipt_printed="0"
	              uuid="a4000000-0000-0000-0000-000000000201"/>
	<cashier_bill bill_id="300" receipt_number="unlocated-receipt" provider_id="0" patient_id="0"
