	              voided="false" receipt_printed="0" uuid="a4000000-0000-0000-0000-000000000300"/>

	<cashier_bill_line_item bill_line_item_id="100" bill_id="100" price="10.00" price_name="default" quantity="1"
	                        line_item_order="0" status="PENDING" creator="1"
	                        date_created="2012-01-01 00:00:00.0" voided="false"
	                        uuid="a5000000-0000-0000-0000-000000000100"/>
	<cashier_bill_line_item bill_line_item_id="200" bill_id="200" price="20.00" price_name="default" quantity="1"
	                        line_item_order="0" status="PENDING" creator="1"
	                        date_created="2012-01-01 00:00:00.0" voided="false"
	                        uuid="a5000000-0000-0000-0000-000000000200"/>
	<cashier_bill_line_item bill_line_item_id="300" bill_id="300" price="30.00" price_name="default" quantity="1"
	                        line_item_order="0" status="PENDING" creator="1"
	                        date_created="2012-01-01 00:00:00.0" voided="false"
	                        uuid="a5000000-0000-0000-0000-000000000300"/>

	<cashier_bill_payment bill_payment_id="100" bill_id="100" payment_mode_id="100" amount="10.00"
	                      amount_tendered="10.00" creator="1" date_created="2012-01-01 00:00:00.0"
