	                    date_created="2012-01-01 00:00:00.0" retired="false"
	                    uuid="b3000000-0000-0000-0000-000000000400"/>
	<cashier_item_price item_price_id="500" billable_drug_id="200" name="default" price="2.00" creator="1"
	                    date_created="2012-01-01 00:00:00.0" retired="false"
	                    uuid="b3000000-0000-0000-0000-000000000500"/>
