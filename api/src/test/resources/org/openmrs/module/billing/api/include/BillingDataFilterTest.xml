<!--
	Billing data spread over two location trees plus a cash point with no location at all, used by
	BillingLocationFilterTest to check what billing_locationBasedBillingFilter does and does not
	return. Supplements CoreTest-2.0.xml, which supplies provider 0, patient 0 and user 1. Every id
	here is 100 or greater so that it cannot collide with the other datasets in this directory.
-->
<dataset>
	<!-- Location tree A: clinic 101 sits under district 100 -->
	<location location_id="100" name="Scoped District" creator="1" date_created="2012-01-01 00:00:00.0"
	          retired="false" uuid="a1000000-0000-0000-0000-000000000100"/>
	<location location_id="101" name="Scoped Clinic" parent_location="100" creator="1"
	          date_created="2012-01-01 00:00:00.0" retired="false" uuid="a1000000-0000-0000-0000-000000000101"/>
	<!-- Location tree B, unrelated to A -->
	<location location_id="200" name="Other Hospital" creator="1" date_created="2012-01-01 00:00:00.0"
	          retired="false" uuid="a1000000-0000-0000-0000-000000000200"/>

	<cashier_cash_point cash_point_id="100" name="Scoped Clinic Cash Point" location_id="101" creator="1"
	                    date_created="2012-01-01 00:00:00.0" retired="false"
	                    uuid="a2000000-0000-0000-0000-000000000100"/>
	<cashier_cash_point cash_point_id="200" name="Other Hospital Cash Point" location_id="200" creator="1"
	                    date_created="2012-01-01 00:00:00.0" retired="false"
	                    uuid="a2000000-0000-0000-0000-000000000200"/>
	<!-- Deliberately has no location, so it belongs to none of the ones a user can be allowed -->
	<cashier_cash_point cash_point_id="300" name="Unlocated Cash Point" creator="1"
	                    date_created="2012-01-01 00:00:00.0" retired="false"
	                    uuid="a2000000-0000-0000-0000-000000000300"/>

	<cashier_payment_mode payment_mode_id="100" name="Scoping Test Payment Mode" creator="1"
	                      date_created="2012-01-01 00:00:00.0" retired="false"
	                      uuid="a3000000-0000-0000-0000-000000000100"/>

	<!-- Catalogue entries: one at the allowed clinic, one at the other hospital, one global -->
	<cashier_billable_service service_id="100" name="Scoped Clinic Consultation" location_id="101"
	                          service_status="ENABLED" creator="1" date_created="2012-01-01 00:00:00.0"
	                          retired="false" uuid="b1000000-0000-0000-0000-000000000100"/>
	<cashier_billable_service service_id="200" name="Other Hospital Consultation" location_id="200"
	                          service_status="ENABLED" creator="1" date_created="2012-01-01 00:00:00.0"
	                          retired="false" uuid="b1000000-0000-0000-0000-000000000200"/>
	<cashier_billable_service service_id="300" name="Global Consultation" service_status="ENABLED" creator="1"
	                          date_created="2012-01-01 00:00:00.0" retired="false"
	                          uuid="b1000000-0000-0000-0000-000000000300"/>

	<cashier_billable_drug billable_drug_id="100" name="Scoped Clinic Paracetamol" location_id="101"
	                       status="ENABLED" creator="1" date_created="2012-01-01 00:00:00.0" retired="false"
	                       uuid="b2000000-0000-0000-0000-000000000100"/>
	<cashier_billable_drug billable_drug_id="200" name="Other Hospital Paracetamol" location_id="200"
	                       status="ENABLED" creator="1" date_created="2012-01-01 00:00:00.0" retired="false"
	                       uuid="b2000000-0000-0000-0000-000000000200"/>
	<cashier_billable_drug billable_drug_id="300" name="Global Paracetamol" status="ENABLED" creator="1"
	                       date_created="2012-01-01 00:00:00.0" retired="false"
	                       uuid="b2000000-0000-0000-0000-000000000300"/>

	<!-- A price for each of the six catalogue entries above, plus one that belongs to neither -->
	<cashier_item_price item_price_id="100" service_id="100" name="default" price="10.00" creator="1"
	                    date_created="2012-01-01 00:00:00.0" retired="false"
	                    uuid="b3000000-0000-0000-0000-000000000100"/>
	<cashier_item_price item_price_id="200" service_id="200" name="default" price="20.00" creator="1"
	                    date_created="2012-01-01 00:00:00.0" retired="false"
	                    uuid="b3000000-0000-0000-0000-000000000200"/>
	<cashier_item_price item_price_id="300" service_id="300" name="default" price="30.00" creator="1"
	                    date_created="2012-01-01 00:00:00.0" retired="false"
	                    uuid="b3000000-0000-0000-0000-000000000300"/>
